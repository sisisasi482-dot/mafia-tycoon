  const isEmpty       = !isMelee && mag === 0;
  const canReload     = !isMelee && mag !== null && mag < magSize && (reserve ?? 0) > 0;
  const noAmmoInShop  = !isMelee && mag === 0 && (reserve ?? 0) === 0;

