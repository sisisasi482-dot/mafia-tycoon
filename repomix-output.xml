export function ChildNPCs() {
  const screen   = useGameStore((s) => s.screen);
  const isPaused = useGameStore((s) => s.isPaused);
  const refs     = useRef<(THREE.Group | null)[]>(CHILD_PLACEMENTS.map(() => null));

