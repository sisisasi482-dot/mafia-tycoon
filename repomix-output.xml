                  : stored.includes(parkableId ?? '')
                  ? 'That vehicle is already stored here'
                  : 'Exit a vehicle near this garage, then enter to park it'}
              </span>
            </div>

            {/* Stored vehicles list */}
            {stored.length > 0 && (
              <div className="flex flex-wrap gap-1.5">
